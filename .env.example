# Ruta opcional. Si se omite, se usa data/sportcrz.db
DATABASE_PATH=./data/sportcrz.db

# Usa una cadena larga y aleatoria en producción.
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# TiloPay (obtén las credenciales en admin.tilopay.com/admin/checkout)
TILOPAY_CHECKOUT_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
# Moneda: USD o CRC
TILOPAY_CURRENCY=USD
