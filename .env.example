# Turso. En producción configura ambas variables como Secret en Vercel.
# Si TURSO_DATABASE_URL está vacía, se usa SQLite local.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Ruta opcional de SQLite local.
DATABASE_PATH=./data/sportcrz.db

# Usa una cadena larga y aleatoria en producción.
ADMIN_SESSION_SECRET=cambia-esto-por-una-cadena-aleatoria-de-al-menos-32-caracteres

# TiloPay (obtén las credenciales en admin.tilopay.com/admin/checkout)
TILOPAY_CHECKOUT_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
# Moneda: USD o CRC
TILOPAY_CURRENCY=USD

# Numero de WhatsApp de la tienda, en formato internacional sin + ni espacios.
# Es el numero al que llegan los pedidos confirmados que envia el cliente.
# Ejemplo: 50761234567
NEXT_PUBLIC_STORE_WHATSAPP=
